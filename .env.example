# Live public domain, no trailing slash. Used for canonical URLs, sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://xiiirenovation.com.sg

# Google Search Console HTML-tag verification code (the content="..." value only). Leave empty if verifying by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). When set, GA loads and WhatsApp / phone / email
# clicks and enquiry-form submissions are sent as `generate_lead` events. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
